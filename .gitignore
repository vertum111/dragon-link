# Whitelist: only the game, its sources, the server and the contract are published.
/*
!/.gitignore
!/README.md
!/netlify.toml
!/netlify/

!/contracts/
/contracts/items/target/

!/server/
/server/state/
/server/node_modules/

!/work/
/work/*
!/work/dragon-duo.js
!/work/dragon-duo.html
!/work/dragon-duo-alt.html
!/work/dragon-ui-manual.js
!/work/dragon-art.js
!/work/item-art.js
!/work/dragon-keys.js
!/work/dragon-hardware.js
!/work/dragon-pack-gallery.js
!/work/dragon-pack-print.js
!/work/hobby-counter.css
!/work/fonts.css
!/work/fonts-alt.css
!/work/build-dragon-duo.sh
!/work/build-dragon-alt.sh
!/work/subset-fonts.py
!/work/subset-fonts-alt.py
!/work/economy/
!/work/chain/
!/work/qa/

!/outputs/
/outputs/*
!/outputs/dragon-link/
/outputs/dragon-link/*
!/outputs/dragon-link/dragon-link-manual.html
!/outputs/dragon-link/dragon-link-3d.html
!/outputs/dragon-link/assets/
!/outputs/dragon-link/kiln-multiview/
!/outputs/dragon-link/brand/
!/outputs/dragon-link/concepts/

# never publish
*.bak.*
*.log
.DS_Store
.env*
*key*.json
*.bak
